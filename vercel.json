{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/review",
      "destination": "/review/index.htm"
    },
    {
      "source": "/review/",
      "destination": "/review/index.htm"
    },
    {
      "source": "/item/:id",
      "destination": "/api/product-share?id=:id"
    },
    {
      "source": "/item/:id/",
      "destination": "/api/product-share?id=:id"
    },
    {
      "source": "/og-image/:id",
      "destination": "/api/product-share?ogImage=:id"
    },
    {
      "source": "/og-image/:id/",
      "destination": "/api/product-share?ogImage=:id"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "item"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|whatsapp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|Pinterest|SkypeUriPreview|Embedly|Redditbot|Applebot|iframely|vkShare|Quora).*"
        }
      ],
      "destination": "/api/product-share"
    }
  ]
}
